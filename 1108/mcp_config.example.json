{
  "mcpServers": {
    "supabase-postgres": {
      "command": "uvx",
      "args": [
        "--python",
        ".venv\\Scripts\\python.exe",
        "--from",
        "postgres-mcp==0.3.0",
        "--override",
        "overrides.txt",
        "postgres-mcp",
        "--access-mode=restricted",
        "postgresql://postgres.<PROJECT_REF>:<PASSWORD>@<HOST>:5432/postgres?sslmode=require"
      ]
    }
  }
}
